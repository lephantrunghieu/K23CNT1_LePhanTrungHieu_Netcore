@model LpthLesson09EF.Models.Publisher

@{
    ViewData["Title"] = "Xoa nha xuat ban";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="LpthDelete">
            <input type="hidden" asp-for="PublisherId" />
            <div class="card">
                <div class="card-header">
                    <h1 class="my-2 text-danger">@ViewData["Title"]</h1>
                    <p>Bạn có chắc chắn muốn xóa nhà xuất bản sau không?</p>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PublisherName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.PublisherName)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Phone)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Phone)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Address)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="form-group my-2">
                        <input type="submit" value="Xoa" class="btn btn-danger" />
                        <a asp-action="LpthIndex" class="btn btn-secondary">Quay lai</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
