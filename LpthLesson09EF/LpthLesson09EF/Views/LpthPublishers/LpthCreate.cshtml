@model LpthLesson09EF.Models.Publisher

@{
    ViewData["Title"] = "Them moi nha xuat ban";
}

<div class="row">
    <div class="col-md-6">
        <form asp-action="LpthCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="card">
                <div class="card-header">
                    <h1 class="my-2">@ViewData["Title"]</h1>
                </div>
                <div class="card-body">
                    <div class="form-group my-1">
                        <label asp-for="PublisherName" class="control-label mb-1"></label>
                        <input asp-for="PublisherName" class="form-control" />
                        <span asp-validation-for="PublisherName" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="Phone" class="control-label mb-1"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="form-group my-1">
                        <label asp-for="Address" class="control-label mb-1"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="form-group my-2">
                        <input type="submit" value="Them moi" class="btn btn-success" />
                        <a asp-action="LpthIndex" class="btn btn-danger">Quay lai</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
