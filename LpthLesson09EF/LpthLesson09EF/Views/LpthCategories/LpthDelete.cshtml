@model LpthLesson09EF.Models.Category

@{
    ViewData["Title"] = "Xóa danh mục";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow rounded-3 border-0">
                <div class="card-header bg-danger text-white text-center">
                    <h3 class="my-2">@ViewData["Title"]</h3>
                    <p class="mb-0 small fst-italic">Bạn có chắc chắn muốn xóa danh mục này?</p>
                </div>

                <div class="card-body px-4">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.CategoryId, htmlAttributes: new { @class = "form-label fw-bold" })
                        <div class="form-control-plaintext border rounded bg-light px-3">
                            @Html.DisplayFor(model => model.CategoryId)
                        </div>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.CategoryName, htmlAttributes: new { @class = "form-label fw-bold" })
                        <div class="form-control-plaintext border rounded bg-light px-3">
                            @Html.DisplayFor(model => model.CategoryName)
                        </div>
                    </div>
                </div>

                <form asp-action="LpthDelete">
                    <input type="hidden" asp-for="CategoryId" />

                    <div class="card-footer text-center bg-light">
                        <button type="submit" class="btn btn-danger me-2">
                            <i class="bi bi-trash3"></i> Xóa
                        </button>
                        <a asp-action="LpthIndex" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
