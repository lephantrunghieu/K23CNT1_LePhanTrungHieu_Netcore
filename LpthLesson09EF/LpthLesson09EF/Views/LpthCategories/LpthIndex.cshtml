@model IEnumerable<LpthLesson09EF.Models.Category>

@{
    ViewData["Title"] = "Danh sach loai sach";
}

<h1 class="text-center">@ViewData["Title"]</h1>
<form asp-action="LpthIndex" method="get" class="form-inline mb-3">
    <div class="form-group">
        <input type="text" name="keyword" class="form-control mr-2" placeholder="Nhập tên danh mục"
               value="@ViewBag.Keyword" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>
<p>
    <a asp-action="LpthCreate">Them moi</a>
</p>
<table class="table table-bordered mt-3">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CategoryId)
            </th>
            <th class="text-center"> Chuc nang</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryId)
           </td>
            <td>
                @Html.DisplayFor(modelItem => item.CategoryName)
            </td>
            <td class="text-center">
                <a asp-action="LpthEdit" asp-route-lpthid="@item.CategoryId" class="btn btn-primary">Sua</a> 
                <a asp-action="LpthDetails" asp-route-lpthid="@item.CategoryId" class="btn btn-info">Xem</a> 
                <a asp-action="LpthDelete" asp-route-lpthid="@item.CategoryId" class="btn btn-danger">Xoa</a>
            </td>
        </tr>
}
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3">
                Tong so: @Model.Count()
            </th>
        </tr>
    </tfoot>
</table>
