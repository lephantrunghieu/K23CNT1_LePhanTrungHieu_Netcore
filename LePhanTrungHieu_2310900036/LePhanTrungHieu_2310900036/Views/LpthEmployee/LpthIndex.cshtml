@model IEnumerable<LePhanTrungHieu_2310900036.Models.LpthEmployee>

@{
    ViewData["Title"] = "Danh sách nhân viên";
}

<h2 class="text-primary mb-4">
    <i class="bi bi-people-fill"></i> Danh sách nhân viên
</h2>

<p>
    <a asp-action="LpthCreate" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Thêm mới
    </a>
</p>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().LpthEmpId)</th>
            <th>@Html.DisplayNameFor(model => model.First().LpthEmpName)</th>
            <th>@Html.DisplayNameFor(model => model.First().LpthEmpLevel)</th>
            <th>@Html.DisplayNameFor(model => model.First().LpthEmpStartDate)</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LpthEmpId</td> <!-- ✅ Thêm cột ID vào dữ liệu -->
                <td>@item.LpthEmpName</td>
                <td>@item.LpthEmpLevel</td>
                <td>
                    @(item.LpthEmpStartDate.HasValue
                        ? item.LpthEmpStartDate.Value.ToString("dd/MM/yyyy")
                        : "Chưa có ngày")
                </td>
                <td>
                    @(item.LpthEmpStatus.HasValue
                        ? (item.LpthEmpStatus.Value ? "Hiển thị" : "Ẩn")
                        : "Không xác định")
                </td>
                <td class="text-center">
                    <a asp-action="LpthDetails" asp-route-id="@item.LpthEmpId" class="btn btn-info btn-sm me-1">
                        <i class="bi bi-eye"></i> Xem
                    </a>
                    <a asp-action="LpthEdit" asp-route-id="@item.LpthEmpId" class="btn btn-warning btn-sm me-1">
                        <i class="bi bi-pencil-square"></i> Sửa
                    </a>
                    <a asp-action="LpthDelete" asp-route-id="@item.LpthEmpId" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash"></i> Xóa
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
