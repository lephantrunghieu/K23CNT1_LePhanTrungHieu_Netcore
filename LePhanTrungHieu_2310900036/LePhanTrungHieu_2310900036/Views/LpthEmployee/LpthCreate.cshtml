@model LePhanTrungHieu_2310900036.Models.LpthEmployee

@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<div class="container mt-4">
    <h2 class="text-success mb-4">
        <i class="bi bi-person-plus-fill"></i> Thêm nhân viên mới
    </h2>

    <div class="row">
        <div class="col-md-6">
            <form asp-action="LpthCreate" class="needs-validation" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="LpthEmpId" class="form-label"></label>
                    <input asp-for="LpthEmpId" class="form-control" />
                    <span asp-validation-for="LpthEmpId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LpthEmpName" class="form-label"></label>
                    <input asp-for="LpthEmpName" class="form-control" />
                    <span asp-validation-for="LpthEmpName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LpthEmpLevel" class="form-label"></label>
                    <input asp-for="LpthEmpLevel" class="form-control" />
                    <span asp-validation-for="LpthEmpLevel" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LpthEmpStartDate" class="form-label"></label>
                    <input asp-for="LpthEmpStartDate" class="form-control" type="date" />
                    <span asp-validation-for="LpthEmpStartDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="LpthEmpStatus" class="form-label"></label>
                    <select asp-for="LpthEmpStatus" class="form-select">
                        <option value="">-- Chọn trạng thái --</option>
                        <option value="true">Hiển thị</option>
                        <option value="false">Ẩn</option>
                    </select>
                    <span asp-validation-for="LpthEmpStatus" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save-fill"></i> Lưu
                    </button>
                    <a asp-action="LpthIndex" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
