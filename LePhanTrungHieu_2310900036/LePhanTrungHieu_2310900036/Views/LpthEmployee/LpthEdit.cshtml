@model LePhanTrungHieu_2310900036.Models.LpthEmployee

@{
    ViewData["Title"] = "Sửa nhân viên";
}

<h2 class="text-warning">Sửa thông tin nhân viên</h2>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="LpthEdit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="LpthEmpId" />

            <div class="form-group">
                <label asp-for="LpthEmpName" class="control-label"></label>
                <input asp-for="LpthEmpName" class="form-control" />
                <span asp-validation-for="LpthEmpName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LpthEmpLevel" class="control-label"></label>
                <input asp-for="LpthEmpLevel" class="form-control" />
                <span asp-validation-for="LpthEmpLevel" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LpthEmpStartDate" class="control-label"></label>
                <input asp-for="LpthEmpStartDate" class="form-control" type="date" />
                <span asp-validation-for="LpthEmpStartDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LpthEmpStatus" class="control-label"></label>
                <select asp-for="LpthEmpStatus" class="form-control">
                    <option value="true" selected="@Model.LpthEmpStatus">Show</option>
                    <option value="false" selected="!@Model.LpthEmpStatus">Hide</option>
                </select>
                <span asp-validation-for="LpthEmpStatus" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                <a asp-action="LpthIndex" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
