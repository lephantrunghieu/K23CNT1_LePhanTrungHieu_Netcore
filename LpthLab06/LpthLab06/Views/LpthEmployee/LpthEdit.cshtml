@model LpthLab06.Models.LpthEmployee

@{
    ViewData["Title"] = "Sửa nhân viên";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="LpthEdit" method="post">
    <input type="hidden" asp-for="LpthId" />
    <div class="mb-3">
        <label asp-for="LpthName" class="form-label"></label>
        <input asp-for="LpthName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LpthBirthDay" class="form-label"></label>
        <input asp-for="LpthBirthDay" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LpthEmail" class="form-label"></label>
        <input asp-for="LpthEmail" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LpthPhone" class="form-label"></label>
        <input asp-for="LpthPhone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LpthSalary" class="form-label"></label>
        <input asp-for="LpthSalary" type="number" class="form-control" />
    </div>
    <div class="form-check mb-3">
        <input asp-for="LpthStatus" class="form-check-input" />
        <label asp-for="LpthStatus" class="form-check-label">Đang làm việc</label>
    </div>
    <button type="submit" class="btn btn-primary">Cập nhật</button>
    <a asp-action="LpthEmployeeList" class="btn btn-secondary">Hủy</a>
</form>
